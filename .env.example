# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com/

# ── Auth method: basic | bearer | oauth | passthrough ──────────────
#
# bearer      → single user, personal token (dev/testing)
# passthrough → multi-user, each user logs in via SAML/SSO (production)
# basic       → single user, username/password
# oauth       → single user, OAuth password grant
SERVICENOW_AUTH_METHOD=bearer

# ── Bearer auth ────────────────────────────────────────────────────
SERVICENOW_BEARER_TOKEN=your-bearer-token-here

# ── Passthrough + OAuth (for production multi-user deployment) ─────
# 1. Create OAuth app in ServiceNow: System OAuth > Application Registry
# 2. Set Redirect URL: http://<mcp-server>:8000/oauth/callback
# 3. Set SERVICENOW_AUTH_METHOD=passthrough and fill in:
# SERVICENOW_OAUTH_CLIENT_ID=your-client-id
# SERVICENOW_OAUTH_CLIENT_SECRET=your-client-secret

# ── Basic auth ─────────────────────────────────────────────────────
# SERVICENOW_BASIC_USERNAME=
# SERVICENOW_BASIC_PASSWORD=

# ── Permission tiers (ignored in passthrough mode) ─────────────────
WRITE_ENABLED=true
CMDB_WRITE_ENABLED=false
SCRIPTING_ENABLED=false
NOW_ASSIST_ENABLED=false

# ── Tool package ───────────────────────────────────────────────────
MCP_TOOL_PACKAGE=full
