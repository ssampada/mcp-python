# ServiceNow MCP Server — Production config
# Copy to /opt/servicenow-mcp/.env and fill in values.

# === Required ===
SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com/

# === Auth mode (pick one) =============================================
#
# Option A: OAuth + SAML SSO (recommended for production)
#   Users log in with their normal SSO credentials.
#   One-time setup: create OAuth app in ServiceNow Application Registry.
#   Set Redirect URL: https://<mcp-server>/oauth/callback
#
SERVICENOW_AUTH_METHOD=passthrough
SERVICENOW_OAUTH_CLIENT_ID=your-client-id-here
SERVICENOW_OAUTH_CLIENT_SECRET=your-client-secret-here
#
# Option B: Bearer token (for dev/testing only)
#   Single user with a personal token.
#
# SERVICENOW_AUTH_METHOD=bearer
# SERVICENOW_BEARER_TOKEN=your-token-here
# WRITE_ENABLED=true
# ======================================================================

# All tools exposed — ServiceNow enforces per-user roles
MCP_TOOL_PACKAGE=full

# Transport (do not change)
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8000
